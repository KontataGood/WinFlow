{
    "process_watcher": {
        "interval": 5,
        "ignored_processes": [],
        "watch_only": []
    },

    "rules": [
        {
            "name": "Todo Automation",
            "enabled": true,
            "event": "PROCESS_STARTED",

            "conditions": [
                {
                    "field": "process",
                    "operator": "equals",
                    "value": "Todo.exe"
                }
            ],

            "actions": [
                {
                    "type": "START_PROGRAM",
                    "program": "notepad.exe"
                },
                {
                    "type": "OPEN_URL",
                    "url": "https://youtube.com"
                }
            ]
        }
    ]
}