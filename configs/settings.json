{
    "process_watcher": {
        "interval": 5,
        "ignored_processes": [],
        "watch_only": []
    },

    "rules": [
        {
            "name": "Open YouTube",
            "enabled": true,
            "event": "PROCESS_STARTED",
            "conditions": {
                "process": "Todo.exe"
            },
            "action": {
                "type": "OPEN_URL",
                "url": "https://youtube.com"
            }
        }
    ]
}