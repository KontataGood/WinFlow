{
    "process_watcher": {
        "interval": 5,
        "ignored_processes": [],
        "watch_only": []
    },

    "rules": [
        {
            "name": "Browser Automation",
            "enabled": true,
            "event": "PROCESS_STARTED",

            "conditions": [
                {
                    "field": "process",
                    "operator": "equals",
                    "value": {
                        "windows": "Todo.exe",
                        "macos": "Safari"
                    }
                }
            ],

            "actions": [
                {
                    "type": "OPEN_URL",
                    "url": "https://youtube.com"
                },
                {
                    "type": "START_PROGRAM",
                    "program": {
                        "windows": "notepad.exe",
                        "macos": "TextEdit"
                    }
                }
            ]
        }
    ]
}