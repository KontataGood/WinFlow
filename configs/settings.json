{
    "process_watcher": {
        "interval": 5,
        "ignored_processes": [],
        "watch_only": []
    },

    "rules": [
        {
            "name": "Stop Todo",
            "enabled": true,
            "event": "PROCESS_STARTED",
            "conditions": {
                "process": "CalculatorApp.exe"
            },
            "action": {
                "type": "STOP_PROGRAM",
                "program": "Todo.exe"
            }
        }
    ]
}